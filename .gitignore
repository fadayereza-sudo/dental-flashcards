# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local claude settings
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flashcard imports (local staging; never commit)
/flashcards-import/**
!/flashcards-import/.gitkeep
!/flashcards-import/README.md

# source-material PDFs — kept locally only (image extraction); never commit (dev server OOMs on large binaries)
/source-material/**/*.pdf

# database backups — contain all card content; keep local only
/backups/
/.cache/

# tagging scaffolding — card content in working batches, keep local only
/tmp-pilot-cards.json
/tmp-tag-batches/
/tmp-tag-results/

# OCR working directory — per-page .txt and .json sidecars; audit-kept locally only
/tmp-ocr-results/

# troubleshooting staging — per-source JSONL of tagged excerpts; rebuilt by extract-troubleshooting skill
/staging/

# rendered PDF page PNGs — large, derivable from the source PDF
/source-material/**/pages/

.playwright-profile/
