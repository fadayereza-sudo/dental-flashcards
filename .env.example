# Neon Postgres — get from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Telegram bot — create via @BotFather, then set webhook to:
#   https://<your-vercel-domain>/api/telegram/webhook?secret=$TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string

# Your Telegram user ID (only this user can access the app).
# Message @userinfobot on Telegram to find it.
TELEGRAM_USER_ID=123456789

# URL of the deployed Mini App (used in notification buttons).
# Must be HTTPS and registered with @BotFather via /newapp.
MINI_APP_URL=https://your-app.vercel.app

# Cron endpoint guard — set the same value in vercel.json header.
CRON_SECRET=generate-another-random-string

# Dev-only: bypass Telegram initData check when browsing locally.
# Leave empty in production.
DEV_BYPASS_TOKEN=

# Password gate for browser access (single shared password).
# Anyone hitting study.dentalbee.co.uk has to enter this on /login.
# Generate something memorable to you, or a random string for max safety.
APP_PASSWORD=change-me

# Cloudflare R2 — object storage for card images.
# 1. Cloudflare dashboard → R2 → Manage R2 API Tokens → Create token
#    with Object Read & Write permissions on the bucket.
# 2. On the bucket: Settings → Public access → Allow r2.dev subdomain.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dental-flashcards-images
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
